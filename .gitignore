# OS
.DS_Store
Thumbs.db

# Python bytecode / cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments and secrets
.venv/
venv/
env/
.env
.env.*
.secrets/
*.secret

# Build / packaging
build/
dist/
*.egg-info/
.eggs/

# Test / coverage / type-checking / linters
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.mypy_cache/
.ruff_cache/
.pyre/

# Jupyter
.ipynb_checkpoints/

# IDE / editors
.vscode/
.idea/
*.swp
*.swo
.history/

# Logs
logs/
*.log

# Data artifacts (tracked via DVC or regenerated)
# Keep placeholders/readme if present
data/*
!data/.gitkeep
!data/README.md
# If you want to keep small reference files in Git, uncomment:
# !data/ref/**

# Models and experiment artifacts
models/*
!models/.gitkeep
!models/README.md
notebooks/guidance_learning/*

experiments/*
!experiments/.gitkeep
!experiments/README.md

# Airflow (if using local logs/output)
airflow_logs/
airflow/.airflowignore
config